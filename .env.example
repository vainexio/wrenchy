# Discord bot token (Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=
# Developer Portal -> OAuth2 -> Client Secret (for dashboard login)
DISCORD_CLIENT_SECRET=
# Only members with this role can log in to the dashboard
ADMIN_ROLE_ID=1560157523984646154
# Random string used to sign dashboard sessions
SESSION_SECRET=
# MongoDB Atlas connection string
MONGODB_URI=
# Public URL of the dashboard (auto-detected on Render; defaults to http://localhost:PORT)
PUBLIC_URL=
# Port for the Express server (Render sets this automatically)
PORT=3000
# Shared secret the Roblox game sends (X-Wrenchy-Key) when linking accounts / reporting roles
GAME_API_KEY=
# Channel the game's auto-farm flags are posted in (defaults to 1561264779505705040)
FLAG_CHANNEL_ID=
